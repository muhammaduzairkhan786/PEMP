@* Access requirements matrix (workbook Tab 3 / FR-ACC-01). Tester defines; status per env. *@
@inject EngagementStore Store
@inject DemoSession Session

@if (Reqs.Count > 0)
{
    <div class="sectionlabel">Access requirements <span class="srs">FR-ACC-01</span></div>
    <div class="card tablecard">
        <table class="t">
            <thead><tr><th>Environment / asset</th><th>URL / detail</th><th>Access</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var r in Reqs)
                {
                    <tr>
                        <td>@r.Environment</td>
                        <td class="mono muted">@r.Url</td>
                        <td>@r.AccessType</td>
                        <td>
                            @if (Editable)
                            {
                                <select class="inp" style="max-width:210px" aria-label="Access status" value="@r.Status" @onchange="e => SetStatus(r, e)">
                                    @foreach (var s in Enum.GetValues<AccessStatus>())
                                    {
                                        <option value="@s">@Label(s)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="pill @Cls(r.Status)">@Label(r.Status)</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted" style="font-size:var(--text-xs);margin-top:8px">Tester defines required access per environment; app team provisions · <span class="srs">FR-ACC-02</span></p>
}
else if (ShowEmpty)
{
    <div class="sectionlabel">Access requirements <span class="srs">FR-ACC-01</span></div>
    <div class="card muted">No access requirements defined yet.</div>
}

@if (Editable)
{
    <div class="card">
        <div class="sectionlabel" style="margin-top:0">Add an access requirement <span class="srs">FR-ACC-01</span></div>
        <div class="q"><label class="qlabel" for="acc-env">Environment / asset</label>
            <input id="acc-env" class="inp" placeholder="environment / asset (e.g. Pre-production)" @bind="_env" /></div>
        <div class="q"><label class="qlabel" for="acc-url">URL / detail</label>
            <input id="acc-url" class="inp" placeholder="URL / detail" @bind="_url" /></div>
        <div class="q" style="border:none">
            <label class="qlabel" for="acc-type">Access</label>
            <select id="acc-type" class="inp" style="max-width:210px" @bind="_type">
                @foreach (var t in new[] { "Read", "Read-Write", "Admin", "Other" }){<option value="@t">@t</option>}
            </select>
            <button class="btn primary" style="margin-top:8px" @onclick="AddRow">Add requirement ▶</button>
            @if (_msg is not null){<span class="muted" style="margin-left:10px" role="status" aria-live="polite">@_msg</span>}
        </div>
    </div>
}

@code {
    [Parameter] public Guid EngagementId { get; set; }
    [Parameter] public List<AccessRequirementRecord> Reqs { get; set; } = new();
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool ShowEmpty { get; set; }
    [Parameter] public EventCallback OnAdded { get; set; }

    string _env = "", _url = "", _type = "Read";
    string? _msg;

    async Task AddRow()
    {
        if (string.IsNullOrWhiteSpace(_env)) { _msg = "Enter an environment / asset."; return; }
        await Store.AddAccessRequirementAsync(EngagementId, _env.Trim(), _url.Trim(), _type,
            actor: Session.Actor, role: Session.Role);
        _env = _url = ""; _type = "Read";
        _msg = "Added — app team to provision (FR-ACC-02).";
        if (OnAdded.HasDelegate) await OnAdded.InvokeAsync();
    }

    async Task SetStatus(AccessRequirementRecord r, ChangeEventArgs e)
    {
        if (Enum.TryParse<AccessStatus>(e.Value?.ToString(), out var s))
        {
            r.Status = s;
            await Store.SetAccessStatusAsync(r.Id, s, actor: Session.Actor, role: Session.Role);
        }
    }

    static string Label(AccessStatus s) => s switch
    {
        AccessStatus.AppTeamToProvision => "App team to provision",
        AccessStatus.InProgress => "In progress",
        AccessStatus.Provisioned => "Provisioned",
        _ => "Not required",
    };

    static string Cls(AccessStatus s) => s switch
    {
        AccessStatus.Provisioned => "ok",
        AccessStatus.InProgress => "wait",
        AccessStatus.AppTeamToProvision => "warn",
        _ => "",
    };
}
