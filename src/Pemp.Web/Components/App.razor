<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script nonce="@CspNonce">
        // Apply saved theme before first paint (no flash); expose a toggle for the UI.
        (function () { try { document.documentElement.setAttribute('data-theme', localStorage.getItem('pemp-theme') || 'dark'); } catch (e) { } })();
        window.pempToggleTheme = function () {
            var h = document.documentElement;
            var t = h.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            h.setAttribute('data-theme', t);
            try { localStorage.setItem('pemp-theme', t); } catch (e) { }
        };
        // Client-side file download (used by the admin audit CSV export).
        window.pempDownload = function (filename, text) {
            var blob = new Blob([text], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = filename;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a); URL.revokeObjectURL(url);
        };
    </script>
    <ResourcePreloader />
    <link rel="stylesheet" href="tokens.css" />
    <link rel="stylesheet" href="pemp.css" />
    <link rel="stylesheet" href="@Assets["Pemp.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Account pages run as static SSR so their form posts hit SignInManager/UserManager
    // server-side; the rest of the app is InteractiveServer.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Per-request CSP nonce (set by the security-headers middleware in Program.cs) authorising
    // the inline theme/download script under the enforcing Content-Security-Policy.
    private string? CspNonce => HttpContext?.Items["csp-nonce"] as string;

    private IComponentRenderMode? RenderModeForPage =>
        HttpContext?.Request.Path.StartsWithSegments("/Account") == true
            ? null
            : InteractiveServer;
}
