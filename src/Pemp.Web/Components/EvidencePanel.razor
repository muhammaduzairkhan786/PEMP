@* Evidence attached to findings (FR-FND-02, SEC-EVD): encrypted-at-rest, signed-URL access *@
@using Pemp.Infrastructure.Evidence
@inject EngagementStore Store
@inject DemoSession Session
@inject IEvidenceStorage Storage
@inject IJSRuntime JS

@if (Findings.Count > 0)
{
    <h2 class="sectionlabel">Evidence <Srs>FR-FND-02 · SEC-EVD-01/02</Srs></h2>
    <div class="card">
        @if (_evidence.Count == 0)
        {
            <p class="muted">No evidence attached yet.</p>
        }
        @foreach (var grp in _evidence.GroupBy(e => e.FindingId))
        {
            var f = Findings.FirstOrDefault(x => x.Id == grp.Key);
            <div class="evgrp">
                <div class="evtitle">@(f?.Title ?? "(finding)")</div>
                @foreach (var e in grp)
                {
                    <div class="evtile">
                        <span class="evkind" aria-hidden="true">@KindIcon(e.Kind)</span>
                        <span class="mono">@e.FileName</span>
                        @if (e.EncryptedAtRest)
                        {
                            <span class="pill ok">encrypted ✓</span>
                        }
                        <span class="muted">@e.Note</span>
                        <button type="button" class="btn ghost" style="margin-left:auto"
                                title="Re-authentication required — opens a short-lived signed link (SEC-EVD-02/03)"
                                @onclick="() => Ask(e)">🔐 Download</button>
                    </div>
                }
            </div>
        }
    </div>

    @if (Editable)
    {
        <div class="card">
            <h3 class="sectionlabel" style="margin-top:0">Attach evidence</h3>
            <div class="q"><label class="qlabel" for="ev-finding">Finding</label>
                <select id="ev-finding" class="inp" @bind="_fid" @ref="_findingRef"
                        aria-invalid="@(_invalid && string.IsNullOrEmpty(_fid) ? "true" : null)"
                        aria-describedby="@(_invalid ? "ev-msg" : null)"><option value="">Finding…</option>@foreach (var f in Findings){<option value="@f.Id">@f.Title</option>}</select></div>
            <div class="q"><label class="qlabel" for="ev-file">File name</label>
                <input id="ev-file" class="inp" placeholder="file name (e.g. poc.png)" @bind="_file" @ref="_fileRef"
                       aria-invalid="@(_invalid && string.IsNullOrWhiteSpace(_file) ? "true" : null)"
                       aria-describedby="@(_invalid ? "ev-msg" : null)" /></div>
            <div class="q"><label class="qlabel" for="ev-kind">Kind</label>
                <select id="ev-kind" class="inp" @bind="_kind">@foreach (var k in Enum.GetValues<EvidenceKind>()){<option value="@k">@k</option>}</select></div>
            <div class="q" style="border:none">
                <label class="qlabel" for="ev-note">Note</label>
                <input id="ev-note" class="inp" placeholder="note" @bind="_note" />
                <button class="btn primary" style="margin-top:8px" @onclick="Add">Attach (encrypted) ▶</button>
                @if (_msg is not null){<span id="ev-msg" class="muted" style="margin-left:10px" role="status" aria-live="polite">@_msg</span>}
            </div>
        </div>
    }
    else if (_msg is not null)
    {
        <p class="muted" style="font-size:var(--text-sm)" role="status" aria-live="polite">@_msg</p>
    }

    @* Evidence download is a privileged, re-auth-gated action (SEC-EVD-03): the SAME step-up ceremony
       as the credential reveal. Only after a valid re-auth is the download audited and a short-lived,
       single-use signed URL minted + opened — see OnDownloadConfirmed. *@
    <ReauthDialog Open="@(_downloadFor is not null)"
                  Title="Download evidence"
                  Intro="You are about to download an evidence artifact. This is a privileged action:"
                  Lines="@DownloadLines"
                  ShowChainNote="false"
                  NoteText="🔐 Enter your current authenticator (TOTP) code to download this artifact"
                  ConfirmLabel="Verify & download ▶"
                  LogContext="@($"evidence download on {EngagementId}")"
                  OnConfirmed="OnDownloadConfirmed" OnCancelled="OnDownloadCancelled" />
}

@code {
    [Parameter] public Guid EngagementId { get; set; }
    [Parameter] public List<FindingRecord> Findings { get; set; } = new();
    [Parameter] public bool Editable { get; set; }

    List<EvidenceRecord> _evidence = new();
    string _fid = "", _file = "", _note = "";
    EvidenceKind _kind = EvidenceKind.Screenshot;
    string? _msg;

    // Validation state: aria-invalid/describedby on the offending field(s) + focus-on-error.
    bool _invalid;
    bool _focusError;
    ElementReference _findingRef, _fileRef;

    Guid _loadedId;

    // Reload when the engagement changes (e.g. navigating to a spawned retest child),
    // not just once per instance — same fix as EngagementView/Assessment.
    protected override async Task OnParametersSetAsync()
    {
        if (EngagementId == _loadedId) return;
        _loadedId = EngagementId;
        _evidence = await Store.EvidenceForAsync(EngagementId);
    }

    async Task Add()
    {
        if (!Guid.TryParse(_fid, out var fid) || string.IsNullOrWhiteSpace(_file))
        {
            _invalid = true; _msg = "Pick a finding and enter a file name."; _focusError = true;
            return;
        }
        _invalid = false;
        await Store.AddEvidenceAsync(EngagementId, fid, _file.Trim(), _kind, _note.Trim(), Session.Caller);
        _file = ""; _note = ""; _msg = "Attached — encrypted at rest (SEC-EVD-01).";
        _evidence = await Store.EvidenceForAsync(EngagementId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusError)
        {
            _focusError = false;
            // Focus the first offending control: the finding picker if unset, else the file name.
            try { await (string.IsNullOrEmpty(_fid) ? _findingRef : _fileRef).FocusAsync(); } catch { /* not rendered */ }
        }
    }

    // ---- Re-auth-gated, audited signed-URL download (SEC-EVD-02/03) ----
    static readonly string[] DownloadLines =
    {
        "Opens a short-lived, single-use signed link to the artifact",
        "Every download is recorded in the tamper-evident audit log",
        "Handle per the engagement's data-handling rules",
    };

    EvidenceRecord? _downloadFor;

    void Ask(EvidenceRecord e) { _downloadFor = e; _msg = null; }

    void OnDownloadCancelled() => _downloadFor = null;

    // Runs only AFTER the ReauthDialog confirms a valid re-auth. Authorize + audit the download
    // server-side (object-level scope + hash-chained Evidence.Downloaded); only on success mint a
    // short-lived signed URL and open it. A failed authorization never mints a link.
    async Task OnDownloadConfirmed()
    {
        var e = _downloadFor;
        _downloadFor = null;
        if (e is null) return;

        var result = await Store.RecordEvidenceDownloadAsync(EngagementId, e.Id, e.FileName, Session.Caller);
        if (result.Failed) { _msg = result.Error; return; }

        var url = Storage.CreateDownloadUrl(e);
        _msg = $"Signed link issued for '{e.FileName}' — downloaded (audited, SEC-EVD-02/03).";
        await JS.InvokeVoidAsync("pempOpenDownload", url);
    }

    static string KindIcon(EvidenceKind k) => k switch
    {
        EvidenceKind.Screenshot => "🖼",
        EvidenceKind.RequestResponse => "↔",
        EvidenceKind.Log => "📄",
        _ => "📎",
    };
}
