@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject DemoSession Session
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<div class="shell">
    <div class="brand"><div class="logo">P</div><b>PEMP</b></div>

    <header class="topbar">
        <span class="eyebrow">Pentest Engagement Management</span>
        <span class="sp"></span>
        <button type="button" class="btn ghost themebtn" onclick="window.pempToggleTheme()" title="Toggle light / dark" aria-label="Toggle light or dark theme">◐ Theme</button>
        <div class="whoami">
            <span class="whoami-name">@Session.Actor</span>
            <span class="whoami-role">@Session.Role</span>
        </div>
        <form action="Account/Logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="btn ghost logout-btn">Sign out</button>
        </form>
    </header>

    <nav class="side">
        <NavLink href="dashboard" Match="NavLinkMatch.All">⌂ My Turn</NavLink>
        @if (Session.Role == "Acme CA Officer")
        {
            <NavLink href="new-request">＋ New Request</NavLink>
        }
        <NavLink href="engagements">◉ Engagements</NavLink>
        <NavLink href="analytics">▦ Analytics</NavLink>
        @if (Session.Role == "System Administrator")
        {
            <NavLink href="admin">⚙ Admin</NavLink>
        }
        <div class="foot">@Session.Role · @Session.Actor</div>
    </nav>

    <main class="content">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }

        var user = (await AuthState).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            Session.Actor = user.FindFirst("DisplayName")?.Value
                ?? user.Identity.Name
                ?? Session.Actor;
            // No recognised role → no-privilege state (empty), not a misleading default that
            // would expose role-gated nav (e.g. New Request) to an unmapped user.
            Session.Role = Array.Find(DemoSession.Roles, user.IsInRole) ?? "";

            // 2FA enrollment gate — LOCAL Identity path only. Entra (production) carries no
            // "tfa" claim and enforces MFA via Conditional Access, so it is left untouched.
            // EnableAuthenticator uses AuthLayout (not this layout), so there is no redirect loop.
            if (!EntraConfigured && user.FindFirst("tfa")?.Value != "true")
            {
                NavigationManager.NavigateTo("Account/EnableAuthenticator", forceLoad: true);
            }
        }
    }

    private bool EntraConfigured =>
        !string.IsNullOrWhiteSpace(Configuration["AzureAd:ClientId"]);
}
