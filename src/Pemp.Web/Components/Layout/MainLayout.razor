@inherits LayoutComponentBase
@inject DemoSession Session

<div class="shell">
    <div class="brand"><div class="logo">P</div><b>PEMP</b></div>

    <header class="topbar">
        <span class="eyebrow">Pentest Engagement Management</span>
        <span class="sp"></span>
        <button type="button" class="btn ghost themebtn" onclick="window.pempToggleTheme()" title="Toggle light / dark" aria-label="Toggle light or dark theme">◐ Theme</button>
        <div class="whoami">
            <span class="whoami-name">@Session.Actor</span>
            <span class="whoami-role">@Session.Role</span>
        </div>
        <form action="Account/Logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="btn ghost logout-btn">Sign out</button>
        </form>
    </header>

    <nav class="side">
        <NavLink href="dashboard" Match="NavLinkMatch.All">⌂ My Turn</NavLink>
        @if (Session.Role == "Acme CA Officer")
        {
            <NavLink href="new-request">＋ New Request</NavLink>
        }
        <NavLink href="engagements">◉ Engagements</NavLink>
        <NavLink href="analytics">▦ Analytics</NavLink>
        @if (Session.Role == "System Administrator")
        {
            <NavLink href="admin">⚙ Admin</NavLink>
        }
        <div class="foot">@Session.Role · @Session.Actor</div>
    </nav>

    <main class="content">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Role/actor come from the authenticated principal, resolved before any markup renders so
    // the whoami + role-gated nav never flash a default identity (the SSR ordering fix). The
    // 2FA-enrollment gate is now enforced SERVER-SIDE in Program.cs (a real 302), not here.
    protected override Task OnInitializedAsync() => Session.EnsureInitializedAsync();
}
