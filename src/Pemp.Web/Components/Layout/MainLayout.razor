@inherits LayoutComponentBase
@inject DemoSession Session
@inject CommsStore Comms
@inject Func<DateTimeOffset> Clock
@inject NavigationManager Nav

<a class="skip-link" href="#main">Skip to content</a>

<div class="shell">
    <a class="brand" href="dashboard" aria-label="PEMP home"><div class="logo">P</div><b>PEMP</b></a>

    <header class="topbar">
        <span class="eyebrow">Pentest Engagement Management</span>
        <span class="sp"></span>
        <button type="button" class="btn ghost themebtn" onclick="window.pempToggleTheme()" title="Toggle light / dark" aria-label="Toggle light or dark theme">◐ Theme</button>
        @* Recent-comms notification badge (FR-NOT-03): a scoped count of messages from the last 7 days
           across the current user's engagements — recency, not per-user read receipts. *@
        <a class="notif" href="dashboard" title="@NotifTitle" aria-label="@NotifTitle">
            🔔@if (_recentComms > 0){<span class="notif-badge">@_recentComms</span>}
        </a>
        <div class="whoami">
            <span class="whoami-name">@Session.Actor</span>
            <span class="whoami-role">@Session.Role</span>
        </div>
        <form action="Account/Logout" method="post" class="logout-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
            <button type="submit" class="btn ghost logout-btn">Sign out</button>
        </form>
    </header>

    <nav class="side">
        @* Role-tailored noun-tabs (DESIGN_PLAN; ≤6 per role, NFR-USA-01). Each role sees only the
           rollups it owns; the portfolio-wide Analytics tab is restricted to the portfolio roles. *@
        <NavLink href="dashboard" Match="NavLinkMatch.All" aria-current="@Cur("dashboard")">⌂ My Turn</NavLink>
        @if (Session.Role == PempRoles.AcmeOfficer)
        {
            <NavLink href="new-request" aria-current="@Cur("new-request")">＋ New Request</NavLink>
        }
        <NavLink href="engagements" aria-current="@Cur("engagements")">◉ Engagements</NavLink>
        @if (Session.Role is PempRoles.AcmeOfficer or PempRoles.DeliveryManager)
        {
            <NavLink href="approvals" aria-current="@Cur("approvals")">✓ @(Session.Role == PempRoles.DeliveryManager ? "Reviews" : "Approvals")</NavLink>
        }
        @if (Session.Role == PempRoles.DeliveryManager)
        {
            <NavLink href="capacity" aria-current="@Cur("capacity")">▤ Capacity</NavLink>
        }
        @if (Session.Role == PempRoles.Tester)
        {
            <NavLink href="my-findings" aria-current="@Cur("my-findings")">⚑ Findings</NavLink>
        }
        @if (PempRoles.IsPortfolio(Session.Role))
        {
            <NavLink href="analytics" aria-current="@Cur("analytics")">▦ Analytics</NavLink>
        }
        @if (Session.Role == PempRoles.Administrator)
        {
            <NavLink href="admin" aria-current="@Cur("admin")">⚙ Admin</NavLink>
        }
        <div class="foot">@Session.Role · @Session.Actor</div>
    </nav>

    <main class="content" id="main" tabindex="-1">@Body</main>

    @* ⌘K command palette — mounted once for the whole shell (the global key listener is in JS). *@
    <CommandPalette />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Role/actor come from the authenticated principal, resolved before any markup renders so
    // the whoami + role-gated nav never flash a default identity (the SSR ordering fix). The
    // 2FA-enrollment gate is now enforced SERVER-SIDE in Program.cs (a real 302), not here.
    int _recentComms;
    string NotifTitle => _recentComms == 0
        ? "No recent messages across your engagements (last 7 days)"
        : $"{_recentComms} recent message{(_recentComms == 1 ? "" : "s")} across your engagements (last 7 days)";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync();
        // Scoped recency count for the badge (fail-closed: an unscoped role sees 0).
        _recentComms = await Comms.RecentCountAsync(Session.Caller, Clock().AddDays(-7));
    }

    // aria-current="page" on the NavLink whose route matches the current path; null elsewhere so the
    // attribute is omitted. The layout re-renders on navigation (@Body changes), so this recomputes.
    string? Cur(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(path, href, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    }
}
