@page "/analytics"
@attribute [Authorize]
@inject EngagementStore Store
@inject DemoSession Session
<PageTitle>Analytics · PEMP</PageTitle>

<div class="wrap">
    <div class="eyebrow">Portfolio</div>
    <h1 class="title">Analytics</h1>
    <p class="sub">@(Session.AppScope is not null || Session.TesterScope is not null ? "Across your engagements." : "Across all engagements — exposure at a glance.")</p>

    @if (_engs is null)
    {
        <div aria-busy="true"><Skeleton Rows="4" /></div>
    }
    else
    {
        var active = _engs.Count(e => e.CurrentStage != Stage.Closed);
        var closed = _engs.Count(e => e.CurrentStage == Stage.Closed);
        var totalOpen = _counts.Sum(c => c.Count);
        var critOpen = _counts.Where(c => c.Severity == Severity.Critical).Sum(c => c.Count);

        <div class="tiles">
            <div class="tile"><div class="k">Active engagements</div><div class="v">@active</div></div>
            <div class="tile"><div class="k">Open findings</div><div class="v">@totalOpen</div></div>
            <div class="tile"><div class="k">Critical open</div><div class="v">@critOpen</div></div>
            <div class="tile"><div class="k">Closed</div><div class="v">@closed</div></div>
        </div>

        <h2 class="sectionlabel">Severity distribution — open findings <Srs>FR-ANL-04</Srs></h2>
        @if (totalOpen == 0)
        {
            <div class="card muted">No open findings.</div>
        }
        else
        {
            <div class="distbar" role="img" aria-label="@DistLabel()">
                @foreach (var s in SevOrder)
                {
                    var n = SevCount(s);
                    if (n > 0)
                    {
                        <span title="@s @n" style="width:@(100 * n / totalOpen)%;background:@SevVar(s)"></span>
                    }
                }
            </div>
            <div class="fchips">
                @foreach (var s in SevOrder)
                {
                    var n = SevCount(s);
                    if (n > 0)
                    {
                        <span class="sevchip @s.ToString().ToLowerInvariant()">@s @n</span>
                    }
                }
            </div>
        }

        <h2 class="sectionlabel">By application</h2>
        <div class="card tablecard">
            <table class="t">
                <thead><tr><th>Application</th><th>Stage</th><th>Open findings</th><th>Worst severity</th></tr></thead>
                <tbody>
                    @if (_engs.Count == 0)
                    {
                        <tr><td colspan="4" class="muted">No engagements yet.</td></tr>
                    }
                    @foreach (var e in _engs)
                    {
                        var of = _counts.Where(c => c.EngagementId == e.Id).ToList();
                        var openCount = of.Sum(c => c.Count);
                        var worst = of.Count == 0 ? (Severity?)null : of.Min(c => c.Severity); // enum-min = worst
                        <tr>
                            <td>@e.AppName</td>
                            <td class="muted">@Workflow.Label(e.CurrentStage)</td>
                            <td class="mono">@openCount</td>
                            <td>@if (worst is not null){<span class="sevchip @worst.ToString()!.ToLowerInvariant()">@worst</span>}else{<span class="muted">—</span>}</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    List<EngagementRecord>? _engs;
    List<OpenFindingCount> _counts = new();

    static readonly Severity[] SevOrder = { Severity.Critical, Severity.High, Severity.Medium, Severity.Low, Severity.Info };

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync(); // resolve role/scope before any query (SSR-safe)
        _engs = await Store.ListScopedAsync(Session.AppScope, Session.TesterScope, Session.Role);
        // Aggregate the open findings IN SQL for exactly the scoped engagements — no portfolio-wide
        // client materialization (FR-ANL-04). The dashboard derives every number from this small set.
        _counts = await Store.OpenFindingCountsAsync(_engs.Select(e => e.Id).ToList());
    }

    int SevCount(Severity s) => _counts.Where(c => c.Severity == s).Sum(c => c.Count);

    static string SevVar(Severity s) => s switch
    {
        Severity.Critical => "var(--sev-critical)",
        Severity.High => "var(--sev-high)",
        Severity.Medium => "var(--sev-medium)",
        Severity.Low => "var(--sev-low)",
        _ => "var(--sev-info)",
    };

    string DistLabel() =>
        string.Join(", ", SevOrder.Select(s => (s, n: SevCount(s))).Where(x => x.n > 0).Select(x => $"{x.s} {x.n}"));
}
