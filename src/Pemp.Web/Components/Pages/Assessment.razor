@page "/engagement/{Id:guid}/assessment"
@attribute [Authorize]
@inject EngagementStore Store
@inject DemoSession Session
@inject IAssessmentDocImporter Importer
@inject IAssessmentXlsxImporter XlsxImporter
@inject ILogger<Assessment> Logger
@inject NavigationManager Nav
<PageTitle>Assessment · PEMP</PageTitle>

@if (!_loaded)
{
    <div class="wrap" aria-busy="true"><Skeleton Rows="4" /></div>
}
else if (_rec is null)
{
    <div class="wrap">
        <h1 class="title">Not available</h1>
        <p class="sub">This engagement doesn't exist, or it isn't in your scope.</p>
        <a class="btn primary" href="">⌂ Back to My Turn</a>
    </div>
}
else
{
    var canEdit = _rec.CurrentStage == Stage.Scoping
        && (Session.Role == PempRoles.Tester || Session.Role == PempRoles.Stakeholder || Session.Role == PempRoles.AcmeOfficer);
    var canComplete = _rec.CurrentStage == Stage.Scoping
        && (Session.Role == PempRoles.Tester || Session.Role == PempRoles.Stakeholder);
    <div class="wrap">
        <div class="eyebrow"><a href="@($"engagement/{Id}")">← @_rec.AppName</a></div>
        <h1 class="title">Assessment &amp; prerequisites</h1>
        <p class="sub">App-team questionnaire (workbook Tab 1). Conditional questions appear based on app type, hosting, and exposure. Auto-saved.</p>

        @if (_done is not null)
        {
            <div class="banner @(_done.Value ? "ok" : "err")">@(_done.Value ? "✓ Assessment marked complete — Scoping advances to SoW." : "⛔ " + _err)</div>
        }

        @if (canEdit)
        {
            <div class="asm-import card">
                <div class="asm-import-head">
                    <div>
                        <b>Start from a filled Word or Excel form</b>
                        <span class="muted">Business teams provide a half-filled .docx or .xlsx — upload it to auto-fill answers, then review &amp; edit.<Srs Sep>FR-SCO-01</Srs></span>
                    </div>
                    <div class="asm-import-templates">
                        <a class="btn ghost" href="assessment/template.docx" target="_blank" rel="noopener">⭳ Word template</a>
                        <a class="btn ghost" href="assessment/template.xlsx" target="_blank" rel="noopener">⭳ Excel template</a>
                    </div>
                </div>
                <label class="asm-drop">
                    <InputFile OnChange="OnUpload" accept=".docx,.xlsx" />
                    <span class="asm-drop-cta">⇧ Upload a filled assessment (.docx or .xlsx)</span>
                    <span class="muted">Word .docx or Excel .xlsx · max 5 MB · parsed in-memory, not stored</span>
                </label>
                @if (_importMsg is not null)
                {
                    <div class="banner ok" role="status">⇲ @_importMsg</div>
                }
                @if (_importErr is not null)
                {
                    <div class="banner err" role="alert">⛔ @_importErr</div>
                }
            </div>
        }

        <AssessmentForm EngagementId="Id" Answers="_answers" ImportedIds="_importedIds"
                        ReadOnly="@(!canEdit)" OnChanged="StateHasChanged" />

        @if (canComplete)
        {
            <div class="card nextaction" style="margin-top:var(--space-4)">
                <div style="font-size:26px">▸</div>
                <div class="meta"><b>Complete &amp; confirm assessment</b><span class="muted">Owner: You (@Session.Role) · FR-SCO-03</span></div>
                <button class="btn primary" @onclick="Complete">Complete &amp; confirm ▶</button>
            </div>
        }
        else if (_rec.CurrentStage != Stage.Scoping)
        {
            <div class="card muted" style="margin-top:var(--space-4)">Assessment was completed — this engagement has moved past Scoping (read-only).</div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    EngagementRecord? _rec;
    Dictionary<string, string> _answers = new();
    HashSet<string>? _importedIds;
    string? _importMsg;
    string? _importErr;
    bool? _done;
    string? _err;

    Guid _loadedId;
    bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureInitializedAsync(); // resolve role/scope before any scoped fetch (SSR-safe)
        if (Id == _loadedId) return;
        _loadedId = Id;
        _loaded = false;
        _rec = await Store.GetScopedAsync(Id, Session.AppScope, Session.TesterScope, Session.Role); // anti-BOLA
        if (_rec is not null) _answers = await Store.AssessmentAnswersAsync(Id);
        _loaded = true;
    }

    // Upload → validate (server-side) → parse (untrusted DATA) → persist each match via the scoped +
    // audited store path. The reader is chosen by extension (.xlsx → Excel, .docx → Word); both feed the
    // SAME mapping + the same ImportAssessmentAsync. The bytes are parsed in-memory and discarded; we keep
    // only the answers + an import audit entry. Any corrupt / unreadable upload is handled gracefully (no 500).
    async Task OnUpload(InputFileChangeEventArgs e)
    {
        _importMsg = null; _importErr = null; _importedIds = null;
        var file = e.File;
        var err = AssessmentUpload.Validate(file.Name, file.ContentType, file.Size);
        if (err is not null) { _importErr = err; return; }
        var isXlsx = AssessmentUpload.IsXlsx(file.Name);
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(AssessmentUpload.MaxBytes).CopyToAsync(ms);
            ms.Position = 0;
            var result = isXlsx ? XlsxImporter.Parse(ms) : Importer.Parse(ms);
            if (result.Matched.Count == 0)
            {
                _importErr = $"No assessment fields could be read from that file. Use a template download for the structured form.";
                return;
            }
            await Store.ImportAssessmentAsync(Id, result.Matched, file.Name, Session.Caller);
            _answers = await Store.AssessmentAnswersAsync(Id);
            _importedIds = result.Matched.Select(m => m.QuestionId).ToHashSet();
            _importMsg = $"Imported {result.Matched.Count} of {result.TotalQuestions} fields from \"{file.Name}\" — review the highlighted ones.";
        }
        catch (UnauthorizedAccessException)
        {
            _importErr = "You're not authorized to edit this assessment.";
        }
        catch (Exception ex)
        {
            // Never surface internals; never log file bytes. WHO/WHAT only.
            Logger.LogWarning(ex, "Assessment import failed for engagement {EngagementId}", Id);
            _importErr = isXlsx
                ? "That file couldn't be read as an Excel .xlsx. Re-export it from the template and try again."
                : "That file couldn't be read as a Word .docx. Re-export it from the template and try again.";
        }
    }

    async Task Complete()
    {
        var result = await Store.CompleteAssessmentAsync(Id, Session.Caller);
        _done = result.Ok;
        _err = result.Error;
        _rec = await Store.GetScopedAsync(Id, Session.AppScope, Session.TesterScope, Session.Role);
    }
}
