@page "/engagement/{Id:guid}"
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject EngagementStore Store
@inject DemoSession Session
@inject NavigationManager Nav
@inject IConfiguration Configuration
@inject IServiceProvider Services
@inject IJSRuntime JS
@implements IAsyncDisposable
<PageTitle>Engagement · PEMP</PageTitle>

@if (!_loaded)
{
    <div class="wrap" aria-busy="true"><Skeleton Rows="5" /></div>
}
else if (_rec is null)
{
    <div class="wrap">
        <h1 class="title">Not available</h1>
        <p class="sub">This engagement doesn't exist, or it isn't in your scope.</p>
        <a class="btn primary" href="">⌂ Back to My Turn</a>
    </div>
}
else
{
    var next = Workflow.Next(_rec);
    var mine = next.Kind != ActionKind.None && next.OwnerRole == Session.Role;

    <div class="wrap">
        <a class="backlink" href="engagements">← Back to engagements</a>
        <div class="eyebrow">Engagement</div>
        <h1 class="title">@_rec.AppName <span class="ref">@_rec.Reference</span></h1>
        <p class="sub">
            <span class="chip @TypeClass(_rec.Type)">@_rec.Type.ToString().ToUpperInvariant()</span>
            <span class="chip crit-@_rec.Criticality.ToLowerInvariant()">@_rec.Criticality criticality</span>
            @if (_rec.ParentId is not null)
            {
                <span class="chip retest">RETEST CHILD</span>
            }
            · tester @(_rec.AssignedTesterName ?? "—")
        </p>

        <div class="card"><Spine Current="_rec.CurrentStage" /></div>

        @if (_reauthFor != ActionKind.None)
        {
            <div class="scrim" @onclick="Cancel" @onkeydown="OnModalKey">
                <div class="modal" @ref="_modalRef" tabindex="-1" role="dialog" aria-modal="true"
                     aria-labelledby="gate-title" @onclick:stopPropagation="true">
                    <h3 id="gate-title">@ModalTitle()</h3>
                    <p class="muted" style="margin-bottom:12px">@ModalIntro()</p>
                    <ul class="attest">@foreach (var l in ModalLines()){<li>@l</li>}</ul>
                    <div class="chainline"><span class="tick">🔗</span> Creates an immutable, hash-chained record<Srs Sep>SEC-AUD-01</Srs></div>
                    @if (EntraConfigured)
                    {
                        <div class="reauthnote">🔐 Re-authenticate via Entra MFA before it commits<Srs Sep>SEC-IAM-04</Srs></div>
                    }
                    else
                    {
                        <div class="reauthnote">🔐 Enter your current authenticator (TOTP) code to confirm this privileged action<Srs Sep>SEC-IAM-04</Srs></div>
                        <input class="inp mono" style="max-width:200px;margin-top:8px" @bind="_totp" @bind:event="oninput"
                               @onkeydown="OnTotpKey" inputmode="numeric" autocomplete="one-time-code" placeholder="123 456" aria-label="Authenticator code" />
                    }
                    @if (_modalError is not null)
                    {
                        <div class="banner err" style="margin-top:8px" role="alert">⛔ @_modalError</div>
                    }
                    <div class="actions">
                        <button class="btn ghost" @onclick="Cancel">Cancel</button>
                        <button class="btn primary" @onclick="ConfirmReauth">@(EntraConfigured ? "Confirm via Entra MFA ▶" : "Verify & confirm ▶")</button>
                    </div>
                </div>
            </div>
        }

        @if (_error is not null)
        {
            @* Guard-FAILURE: a blocked enforced transition must be announced to assistive tech — the
               product's defining trait is otherwise unperceivable to a screen-reader user (fleet rank 5). *@
            <div class="banner err" role="alert">⛔ @_error</div>
        }
        @if (_ok is not null)
        {
            <div class="banner ok" role="status" aria-live="polite">✓ @_ok</div>
        }

        @if (next.Kind == ActionKind.None)
        {
            <div class="card"><b>Engagement closed.</b> Final report released and stored immutable (FR-REP-04).
                @if (_rec.RetestRequested){<span class="muted"> · ↻ a retest child engagement was created.</span>}
            </div>
            @if (_rec.CurrentStage == Stage.Closed && !_rec.RetestRequested && (Session.Role == PempRoles.AcmeOfficer || Session.Role == PempRoles.Stakeholder))
            {
                <div style="margin-top:var(--space-2)"><button class="btn ghost" @onclick="Retest">↻ Request a retest (optional) · FR-RET-01</button></div>
            }
        }
        else if (mine)
        {
            <div class="card nextaction">
                <div style="font-size:26px">▸</div>
                <div class="meta"><b>@next.Label</b><span class="muted">Owner: You (@Session.Role)@(Workflow.NeedsReauth(next.Kind) ? " · re-auth required (SEC-IAM-04)" : "")</span></div>
                @if (next.Kind == ActionKind.AssignTester)
                {
                    <div class="picker">
                        <label class="qlabel">Assign from the capacity board <Srs>FR-ASG-02/03</Srs></label>
                        <select class="inp" style="max-width:300px" @bind="_assignTesterId">
                            @foreach (var t in DemoSeeder.Testers)
                            {
                                <option value="@t.Id">@t.Name — @Capacity(t.Name) active</option>
                            }
                        </select>
                        <button class="btn primary" style="margin-top:8px" @onclick="() => OnAct(ActionKind.AssignTester)">Assign tester ▶</button>
                    </div>
                }
                else if (next.Kind == ActionKind.CompleteAssessment)
                {
                    <a class="btn primary" href="@($"engagement/{Id}/assessment")">Open assessment form ▶</a>
                }
                else if (next.Kind == ActionKind.PeerReview)
                {
                    @if (IsAuthor)
                    {
                        <p class="muted">QA peer review needs an <b>independent reviewer</b> — the report's author can't pass their own QA (FR-REP-02). Another tester must sign in to review.</p>
                    }
                    else
                    {
                        <button class="btn" @onclick="() => OnAct(ActionKind.PeerReviewReject)">Return to draft</button>
                        <button class="btn primary" @onclick="() => OnAct(ActionKind.PeerReview)">Pass QA ▶</button>
                    }
                }
                else
                {
                    <button class="btn primary" @onclick="() => OnAct(next.Kind)">@next.Label ▶</button>
                }
            </div>
        }
        else
        {
            <div class="card">⏳ Waiting on <b>@next.OwnerRole</b> — "@next.Label". <span class="muted">You're viewing as @Session.Role.</span>
                @if (next.Kind == ActionKind.CompleteAssessment && Session.Role == PempRoles.Stakeholder)
                {
                    <div style="margin-top:10px"><a class="btn ghost" href="@($"engagement/{Id}/assessment")">Open assessment form (provide input)</a></div>
                }
            </div>
        }

        <AccessRequirements EngagementId="Id" Reqs="_access"
                            ShowEmpty="@((int)_rec.CurrentStage >= (int)Stage.Access)"
                            Editable="@(_rec.CurrentStage == Stage.Access && Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor)"
                            OnAdded="Load" />

        <TestCredentialsPanel EngagementId="Id" Credentials="_credentials"
                              CanView="@(Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor)"
                              ShowEmpty="@(_rec.CurrentStage == Stage.Access || _rec.CurrentStage == Stage.Execution)" />

        <FindingsRegister Findings="_findings" EngagementId="Id"
                          ShowEmpty="@((int)_rec.CurrentStage >= (int)Stage.Execution)"
                          CanAdd="@(Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor
                                    && (_rec.CurrentStage == Stage.Execution || _rec.CurrentStage == Stage.Findings))"
                          CanRetest="@(Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor
                                       && _rec.CurrentStage == Stage.Retest)"
                          OnAdded="Load" />

        <EvidencePanel EngagementId="Id" Findings="_findings" Editable="@(Session.Role == PempRoles.Tester && _rec.CurrentStage != Stage.Closed)" />

        @if ((int)_rec.CurrentStage >= (int)Stage.Access)
        {
            <ChecklistPanel EngagementId="Id" Done="_checklist"
                            Editable="@(Session.Role == PempRoles.Tester && (int)_rec.CurrentStage >= (int)Stage.Access && _rec.CurrentStage != Stage.Closed)" />
        }

        <h2 class="sectionlabel">
            Audit trail <Srs>SEC-AUD-01</Srs>
            <button class="btn ghost" style="margin-left:8px" @onclick="Verify">Verify chain</button>
            @if (_chainOk is not null)
            {
                <span class="pill @(_chainOk == true ? "ok" : "warn")" role="status" aria-live="polite">@(_chainOk == true ? "🔗 verified" : "⚠ broken")</span>
            }
        </h2>
        <div class="card tablecard">
            <table class="t">
                <thead><tr><th>#</th><th>Actor</th><th>Action</th><th>Before → After</th><th>When</th></tr></thead>
                <tbody>
                    @foreach (var a in _audit)
                    {
                        <tr>
                            <td class="mono">@a.Sequence</td>
                            <td>@a.Actor</td>
                            <td class="mono">@a.Action</td>
                            <td class="mono muted">@a.Before → @a.After</td>
                            <td class="muted">@a.Timestamp.ToString("dd MMM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    // Re-auth gate (SEC-IAM-04). On the LOCAL Identity path the ceremony is REAL: the user must
    // enter a fresh authenticator (TOTP) code, verified server-side before the privileged action
    // runs (see ConfirmReauth/VerifyTotpAsync). On the Entra path real step-up is an acr concern
    // handled by Conditional Access in prod, so that path keeps the existing confirm flag.
    bool EntraConfigured => !string.IsNullOrWhiteSpace(Configuration["AzureAd:ClientId"]);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // Fresh-TOTP entry for the local re-auth gate, and any inline error from a bad/blank code.
    string _totp = "";
    string? _modalError;

    EngagementRecord? _rec;
    List<AuditEntryRow> _audit = new();
    List<FindingRecord> _findings = new();
    List<AccessRequirementRecord> _access = new();
    List<TestCredentialRecord> _credentials = new();
    HashSet<string> _checklist = new();

    // Capacity board + selected tester for the Assignment-stage picker (FR-ASG-02/03).
    Dictionary<string, int> _capacity = new();
    Guid _assignTesterId = DemoSeeder.TesterKhan;
    int Capacity(string name) => _capacity.TryGetValue(name, out var n) ? n : 0;
    string? _error, _ok;
    bool? _chainOk;
    ActionKind _reauthFor = ActionKind.None;
    ElementReference _modalRef;
    bool _focusModal;
    IJSObjectReference? _focusTrap;

    static string TesterName(Guid id) => Array.Find(DemoSeeder.Testers, t => t.Id == id)?.Name ?? "A. Khan";

    // QA peer review records the REAL acting user as the reviewer (no substitution). Map their
    // display name to a tester id so the domain's no-self-review guard (FR-REP-02) compares the
    // actual reviewer against the author; if the author is the only tester present, it blocks.
    Guid ActingTesterId() => Array.Find(DemoSeeder.Testers, t => t.Name == Session.Actor)?.Id ?? Guid.Empty;
    bool IsAuthor => _rec is not null && _rec.AssignedTesterName == Session.Actor;

    Guid _loadedId;
    bool _loaded;

    // Load on parameter set (guarded on Id change) so EngagementView→EngagementView
    // navigation (e.g. opening a spawned retest child) refreshes instead of showing stale data.
    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureInitializedAsync(); // resolve role/scope before any scoped fetch (SSR-safe)
        if (Id == _loadedId) return;
        _loadedId = Id;
        _loaded = false;
        await Load();
    }

    async Task Load()
    {
        // anti-BOLA + fail-closed scope: a scoped role with no concrete scope reaches nothing (SEC-AZN/SEC-INS-01).
        _rec = await Store.GetScopedAsync(Id, Session.AppScope, Session.TesterScope, Session.Role);
        if (_rec is not null)
        {
            // Tamper-evidence is checked on READ and surfaced automatically (SEC-AUD-01), not only on a button.
            var (rows, intact) = await Store.AuditForVerifiedAsync(Id);
            _audit = rows;
            _chainOk = intact;
            _findings = await Store.FindingsForAsync(Id);
            _access = await Store.AccessReqsForAsync(Id);
            _checklist = await Store.ChecklistDoneAsync(Id);
            // Least exposure (SEC-CRD): only fetch test credentials for the assigned tester who may view them.
            _credentials = (Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor)
                ? await Store.CredentialsForAsync(Id)
                : new();
            if (_rec.CurrentStage == Stage.Assignment)
                _capacity = await Store.ActiveAssignmentCountsAsync(); // capacity board for the picker
        }
        else
        {
            _audit = new(); _findings = new(); _access = new(); _checklist = new();
            _credentials = new(); _capacity = new();
        }
        _loaded = true;
    }

    async Task OnAct(ActionKind k)
    {
        _error = _ok = null; _chainOk = null;
        if (Workflow.NeedsReauth(k))
        {
            _reauthFor = k; _focusModal = true; _totp = ""; _modalError = null; // open the re-auth ceremony
        }
        else await Run(k, false);                          // await so the UI re-renders (async DB providers)
    }

    // Confirm the privileged action from the re-auth modal. Local path: a fresh authenticator TOTP
    // code is verified server-side BEFORE the action runs; a wrong/blank code blocks it and changes
    // nothing. Entra path: keeps the existing confirm flag (real step-up is enforced in prod).
    async Task ConfirmReauth()
    {
        var action = _reauthFor;
        if (EntraConfigured) { await ReleaseFocusTrapAsync(); await Run(action, true); return; }

        _modalError = null;
        if (await VerifyTotpAsync(_totp))
        {
            _totp = "";
            await ReleaseFocusTrapAsync();   // restore focus to the trigger before the modal unmounts
            await Run(action, true);
        }
        else
        {
            _modalError = "That authenticator code wasn't valid. Re-enter the current 6-digit code from your app.";
        }
    }

    // Verify a fresh TOTP against the signed-in user's authenticator key (local Identity path only).
    // The code is never logged. Returns false on any missing dependency so the action stays blocked.
    async Task<bool> VerifyTotpAsync(string code)
    {
        if (string.IsNullOrWhiteSpace(code) || AuthState is null) return false;
        var userManager = Services.GetService<UserManager<ApplicationUser>>();
        if (userManager is null) return false;
        var principal = (await AuthState).User;
        var user = await userManager.GetUserAsync(principal);
        if (user is null) return false;
        var normalized = code.Replace(" ", string.Empty).Replace("-", string.Empty);
        return await userManager.VerifyTwoFactorTokenAsync(
            user, userManager.Options.Tokens.AuthenticatorTokenProvider, normalized);
    }

    // Trap focus inside the gate-ceremony dialog and move focus to the right control on open
    // (the TOTP input on the local path; the first focusable on the Entra path) — accessibility.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModal && _reauthFor != ActionKind.None)
        {
            _focusModal = false;
            _focusTrap ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/focus-trap.js");
            var initial = EntraConfigured ? null : "input[autocomplete='one-time-code']";
            await _focusTrap.InvokeVoidAsync("activate", _modalRef, initial);
        }
    }

    // Release the trap and return focus to the trigger button. Called before the modal unmounts.
    async Task ReleaseFocusTrapAsync()
    {
        if (_focusTrap is not null)
        {
            try { await _focusTrap.InvokeVoidAsync("release", _modalRef); } catch { /* circuit gone */ }
        }
    }

    async Task OnModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Cancel();
    }

    // Enter on the TOTP field confirms the privileged action (keyboard parity with the primary
    // button); Esc-to-close is handled by OnModalKey on the scrim. Entra path has no TOTP field.
    async Task OnTotpKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmReauth();
    }

    async Task Cancel()
    {
        await ReleaseFocusTrapAsync();
        _reauthFor = ActionKind.None; _totp = ""; _modalError = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_focusTrap is not null)
        {
            try { await _focusTrap.DisposeAsync(); } catch { /* circuit already torn down */ }
        }
    }

    string ModalTitle() => _reauthFor switch
    {
        ActionKind.SignSow => "Sign Statement of Work",
        ActionKind.VerifyAccess => "Verify access & start testing",
        _ => "Release final report",
    };

    string ModalIntro() => _reauthFor switch
    {
        ActionKind.SignSow => "You are agreeing to:",
        ActionKind.VerifyAccess => "You are confirming:",
        _ => "You are releasing:",
    };

    string[] ModalLines() => _reauthFor switch
    {
        ActionKind.SignSow => new[] { $"Scope: {_rec!.AppName} ({_rec.Type})", "Methodology & dates per the SoW draft", "Prerequisites & test accounts" },
        ActionKind.VerifyAccess => new[] { "Access to the in-scope environments is provisioned and working", "Credentials are valid and time-boxed", "Access is verified — testing can then begin (IR notice next)" },
        _ => new[] { "Final report — peer QA passed", "Vulnerability register snapshot", "Stored immutable on release" },
    };

    async Task Run(ActionKind k, bool reauth)
    {
        _reauthFor = ActionKind.None;
        _error = _ok = null; _chainOk = null;
        var actor = Session.Actor;

        var result = k switch
        {
            ActionKind.RouteToDm        => await Store.ExecuteAsync(Id, e => e.RouteToDeliveryManager(actor)),
            ActionKind.AssignTester     => await Store.AssignTesterAsync(Id, _assignTesterId, TesterName(_assignTesterId), actor),
            ActionKind.CompleteAssessment => await Store.ExecuteAsync(Id, e => e.CompleteAssessment(actor)),
            ActionKind.ReviewSow        => await Store.ExecuteAsync(Id, e => e.ReviewSowAsDeliveryManager(actor)),
            ActionKind.SignSow          => await Store.ExecuteAsync(Id, e => e.SignSow(actor, reauth)),
            ActionKind.VerifyAccess     => await Store.ExecuteAsync(Id, e => e.VerifyAccess(actor, reauth)),
            ActionKind.SendIr           => await Store.ExecuteAsync(Id, e => e.SendIrNotice(actor)),
            ActionKind.EndTest          => await Store.ExecuteAsync(Id, e => e.EndTest(actor)),
            ActionKind.GenerateDraft    => await Store.ExecuteAsync(Id, e => e.GenerateDraft(actor)),
            ActionKind.PeerReview       => await Store.ExecuteAsync(Id, e => e.PeerReview(ActingTesterId(), true, actor)),
            ActionKind.PeerReviewReject => await Store.ExecuteAsync(Id, e => e.PeerReview(ActingTesterId(), false, actor)),
            ActionKind.ReleaseFinal     => await Store.ExecuteAsync(Id, e => e.ReleaseFinal(actor, reauth)),
            ActionKind.CompleteRetest   => await Store.CompleteRetestAsync(Id, actor),
            _ => Result.Fail("Unsupported action."),
        };

        if (result.Failed) _error = result.Error;
        else _ok = "Done — state advanced and the audit chain was appended atomically.";
        await Load();
    }

    void Verify() => _chainOk = Store.VerifyChain();

    async Task Retest()
    {
        _error = _ok = null; _chainOk = null;
        var (result, childId) = await Store.RequestRetestAsync(Id, Session.Actor);
        if (result.Failed || childId is null) { _error = result.Error; await Load(); return; }
        Nav.NavigateTo($"engagement/{childId}");
    }

    static string TypeClass(EngagementType t) =>
        t == EngagementType.Project ? "project" : t == EngagementType.Bau ? "bau" : "retest";
}
