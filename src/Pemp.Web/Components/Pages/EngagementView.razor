@page "/engagement/{Id:guid}"
@attribute [Authorize]
@inject EngagementStore Store
@inject CommsStore Comms
@inject DemoSession Session
@inject NavigationManager Nav
<PageTitle>Engagement · PEMP</PageTitle>

@if (!_loaded)
{
    <div class="wrap" aria-busy="true"><Skeleton Rows="5" /></div>
}
else if (_rec is null)
{
    <div class="wrap">
        <h1 class="title">Not available</h1>
        <p class="sub">This engagement doesn't exist, or it isn't in your scope.</p>
        <a class="btn primary" href="">⌂ Back to My Turn</a>
    </div>
}
else
{
    var next = Workflow.Next(_rec);
    var mine = next.Kind != ActionKind.None && next.OwnerRole == Session.Role;

    <div class="wrap">
        <a class="backlink" href="engagements">← Back to engagements</a>
        <header class="eng-head">
            <div class="eyebrow">Engagement</div>
            <h1 class="title">@_rec.AppName <span class="ref">@_rec.Reference</span></h1>
            <p class="sub">
                <span class="chip @TypeClass(_rec.Type)">@_rec.Type.ToString().ToUpperInvariant()</span>
                <span class="chip crit-@_rec.Criticality.ToLowerInvariant()">@_rec.Criticality criticality</span>
                @if (_rec.ParentId is not null)
                {
                    <span class="chip retest">RETEST CHILD</span>
                }
                <span class="eng-tester">tester @(_rec.AssignedTesterName ?? "—")</span>
            </p>
        </header>

        @* The spine + the current next-action card own the viewport; everything else is progressively
           disclosed behind the drawer-rail tabs below (DESIGN_PLAN §1.4 / §4 / fleet ranks 23+28). *@
        <div class="card eng-spine">
            <div class="eng-spine-eyebrow">Engagement lifecycle</div>
            <Spine Current="_rec.CurrentStage" />
        </div>

        @if (_error is not null)
        {
            @* Guard-FAILURE: a blocked enforced transition must be announced to assistive tech — the
               product's defining trait is otherwise unperceivable to a screen-reader user (fleet rank 5). *@
            <div class="banner err" role="alert">⛔ @_error</div>
        }
        @if (_ok is not null)
        {
            <div class="banner ok" role="status" aria-live="polite">✓ @_ok</div>
        }

        <PanelBoundary Label="The next action">
            @if (next.Kind == ActionKind.None)
            {
                <div class="card"><b>Engagement closed.</b> Final report released and stored immutable (FR-REP-04).
                    @if (_rec.RetestRequested){<span class="muted"> · ↻ a retest child engagement was created.</span>}
                </div>
                @if (_rec.CurrentStage == Stage.Closed && !_rec.RetestRequested && (Session.Role == PempRoles.AcmeOfficer || Session.Role == PempRoles.Stakeholder))
                {
                    <div style="margin-top:var(--space-2)"><button class="btn ghost" @onclick="Retest">↻ Request a retest (optional) · FR-RET-01</button></div>
                }
            }
            else if (mine)
            {
                <div class="card nextaction">
                    <div class="na-mark" aria-hidden="true">▸</div>
                    <div class="meta"><b>@next.Label</b><span class="muted">Owner: You (@Session.Role)@(Workflow.NeedsReauth(next.Kind) ? " · re-auth required (SEC-IAM-04)" : "")</span></div>
                    @if (next.Kind == ActionKind.AssignTester)
                    {
                        <div class="picker">
                            <label class="qlabel">Assign from the capacity board <Srs>FR-ASG-02/03</Srs></label>
                            <select class="inp" style="max-width:300px" @bind="_assignTesterId" disabled="@_busy">
                                @foreach (var t in DemoSeeder.Testers)
                                {
                                    <option value="@t.Id">@t.Name — @Capacity(t.Name) active</option>
                                }
                            </select>
                            <button class="btn primary" style="margin-top:8px" disabled="@_busy" @onclick="() => OnAct(ActionKind.AssignTester)">@(_busy ? "Working…" : "Assign tester ▶")</button>
                        </div>
                    }
                    else if (next.Kind == ActionKind.CompleteAssessment)
                    {
                        <a class="btn primary" href="@($"engagement/{Id}/assessment")">Open assessment form ▶</a>
                    }
                    else if (next.Kind == ActionKind.PeerReview)
                    {
                        @if (IsAuthor)
                        {
                            <p class="muted">QA peer review needs an <b>independent reviewer</b> — the report's author can't pass their own QA (FR-REP-02). Another tester must sign in to review.</p>
                        }
                        else
                        {
                            <button class="btn" disabled="@_busy" @onclick="() => OnAct(ActionKind.PeerReviewReject)">Return to draft</button>
                            <button class="btn primary" disabled="@_busy" @onclick="() => OnAct(ActionKind.PeerReview)">@(_busy ? "Working…" : "Pass QA ▶")</button>
                        }
                    }
                    else
                    {
                        <button class="btn primary" disabled="@_busy" @onclick="() => OnAct(next.Kind)">@(_busy ? "Working…" : next.Label + " ▶")</button>
                    }
                </div>
            }
            else
            {
                <div class="card">⏳ Waiting on <b>@next.OwnerRole</b> — "@next.Label". <span class="muted">You're viewing as @Session.Role.</span>
                    @if (next.Kind == ActionKind.CompleteAssessment && Session.Role == PempRoles.Stakeholder)
                    {
                        <div style="margin-top:10px"><a class="btn ghost" href="@($"engagement/{Id}/assessment")">Open assessment form (provide input)</a></div>
                    }
                </div>
            }
        </PanelBoundary>

        @* Drawer-rail: only the active section renders, so the secondary panels don't all stack into a
           long scroll and the audit table is fetched lazily (behind its tab), not on every open. *@
        <EngagementTabs Tabs="BuildTabs()" Active="@_activeTab" ActiveChanged="OnTabChanged" />

        <div id="@($"panel-{_activeTab}")" role="tabpanel" aria-labelledby="@($"tab-{_activeTab}")" tabindex="0" class="tabpanel">
            @if (_activeTab == "overview")
            {
                <PanelBoundary Label="Overview">
                    <div class="card">
                        <h2 class="sectionlabel" style="margin-top:0">Overview</h2>
                        <dl class="ovgrid">
                            <div><dt>Type</dt><dd>@_rec.Type</dd></div>
                            <div><dt>Criticality</dt><dd>@_rec.Criticality</dd></div>
                            <div><dt>Current stage</dt><dd>@Workflow.Label(_rec.CurrentStage)</dd></div>
                            <div><dt>Assigned tester</dt><dd>@(_rec.AssignedTesterName ?? "—")</dd></div>
                            <div><dt>Findings</dt><dd>@_findings.Count</dd></div>
                            <div><dt>Access items</dt><dd>@_access.Count</dd></div>
                            @if (_rec.ParentId is not null)
                            {
                                <div><dt>Retest of</dt><dd>linked parent engagement</dd></div>
                            }
                        </dl>
                        <p class="muted" style="font-size:var(--text-xs);margin-top:var(--space-2)">
                            Use the tabs above to open findings, access &amp; credentials, evidence, the tester checklist, and the tamper-evident audit trail.
                        </p>
                    </div>
                </PanelBoundary>
            }
            else if (_activeTab == "findings")
            {
                <PanelBoundary Label="Findings">
                    <FindingsRegister Findings="_findings" EngagementId="Id"
                                      ShowEmpty="FindingsShowEmpty"
                                      CanAdd="CanAddFinding"
                                      CanRetest="CanRetestFindings"
                                      OnAdded="OnFindingsChanged" />
                </PanelBoundary>
            }
            else if (_activeTab == "access")
            {
                <PanelBoundary Label="Access &amp; credentials">
                    <AccessRequirements EngagementId="Id" Reqs="_access"
                                        ShowEmpty="AccessShowEmpty"
                                        Editable="CanEditAccess"
                                        OnAdded="OnAccessChanged" />

                    <TestCredentialsPanel EngagementId="Id" Credentials="_credentials"
                                          CanView="CanViewCredentials"
                                          ShowEmpty="CredShowEmpty" />
                </PanelBoundary>
            }
            else if (_activeTab == "evidence")
            {
                <PanelBoundary Label="Evidence">
                    <EvidencePanel EngagementId="Id" Findings="_findings" Editable="CanEditEvidence" />
                    @if (_findings.Count == 0)
                    {
                        <div class="card muted">Evidence attaches to findings — it appears here once findings are recorded.</div>
                    }
                </PanelBoundary>
            }
            else if (_activeTab == "checklist")
            {
                <PanelBoundary Label="Checklist">
                    @if (ShowChecklist)
                    {
                        <ChecklistPanel EngagementId="Id" Done="_checklist" Editable="CanEditChecklist" />
                    }
                    else
                    {
                        <div class="card muted">The tester checklist becomes available once the engagement reaches access verification.</div>
                    }
                </PanelBoundary>
            }
            else if (_activeTab == "comms")
            {
                <PanelBoundary Label="Communications">
                    <CommsLog EngagementId="Id" Messages="_comms" CanPost="true" OnPosted="OnCommsChanged" />
                </PanelBoundary>
            }
            else if (_activeTab == "audit")
            {
                <PanelBoundary Label="Audit trail">
                    <h2 class="sectionlabel">
                        Audit trail <Srs>SEC-AUD-01</Srs>
                        <button class="btn ghost" style="margin-left:8px" @onclick="Verify">Verify chain</button>
                        @if (_chainOk is not null)
                        {
                            <span class="pill @(_chainOk == true ? "ok" : "warn")" role="status" aria-live="polite">@(_chainOk == true ? "🔗 verified" : "⚠ broken")</span>
                        }
                    </h2>
                    @if (!_auditLoaded)
                    {
                        <div class="card" aria-busy="true"><Skeleton Rows="4" /></div>
                    }
                    else
                    {
                        <div class="card tablecard">
                            <table class="t">
                                <thead><tr><th>#</th><th>Actor</th><th>Action</th><th>Before → After</th><th>When</th></tr></thead>
                                <tbody>
                                    @foreach (var a in _audit)
                                    {
                                        <tr>
                                            <td class="mono">@a.Sequence</td>
                                            <td>@a.Actor</td>
                                            <td class="mono">@a.Action</td>
                                            <td class="mono muted">@a.Before → @a.After</td>
                                            <td class="muted">@a.Timestamp.ToString("dd MMM HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </PanelBoundary>
            }
        </div>

        @* The SEC-IAM-04 step-up ceremony (extracted into ReauthDialog). It owns the focus-trap and,
           on the local path, server-side fresh-TOTP verification; OnConfirmed fires only after a valid
           code, then the privileged action runs. *@
        <ReauthDialog Open="@(_reauthFor != ActionKind.None)"
                      Title="@ModalTitle()" Intro="@ModalIntro()" Lines="@ModalLines()"
                      ShowChainNote="true"
                      ConfirmLabel="Verify & confirm ▶"
                      LogContext="@($"{_reauthFor} on {Id} by actor={Session.Actor}")"
                      OnConfirmed="OnReauthConfirmed" OnCancelled="OnReauthCancelled" />
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    EngagementRecord? _rec;
    List<AuditEntryRow> _audit = new();
    List<FindingRecord> _findings = new();
    List<AccessRequirementRecord> _access = new();
    List<TestCredentialRecord> _credentials = new();
    List<CommsMessageRecord> _comms = new();
    HashSet<string> _checklist = new();

    // Capacity board + selected tester for the Assignment-stage picker (FR-ASG-02/03).
    Dictionary<string, int> _capacity = new();
    Guid _assignTesterId = DemoSeeder.TesterKhan;
    int Capacity(string name) => _capacity.TryGetValue(name, out var n) ? n : 0;

    string? _error, _ok;
    bool? _chainOk;
    ActionKind _reauthFor = ActionKind.None;
    bool _busy;          // an action is in flight — disables the next-action control (anti double-submit)
    bool _auditLoaded;   // lazy: the audit rows are fetched only when the Audit tab is opened
    string _activeTab = "overview";

    Guid _loadedId;
    bool _loaded;

    // ── Authorization predicates, defined once (decomposed from the inline ternaries — fleet rank 28).
    // Object-level scope is still enforced server-side on every fetch/action; these only gate the UI.
    bool IsAssignedTester => _rec is not null && Session.Role == PempRoles.Tester && _rec.AssignedTesterName == Session.Actor;
    bool IsAuthor => _rec is not null && _rec.AssignedTesterName == Session.Actor;
    bool CanViewCredentials => IsAssignedTester;
    bool CanEditAccess => _rec is not null && _rec.CurrentStage == Stage.Access && IsAssignedTester;
    bool CanAddFinding => _rec is not null && IsAssignedTester && (_rec.CurrentStage == Stage.Execution || _rec.CurrentStage == Stage.Findings);
    bool CanRetestFindings => _rec is not null && IsAssignedTester && _rec.CurrentStage == Stage.Retest;
    bool CanEditEvidence => _rec is not null && Session.Role == PempRoles.Tester && _rec.CurrentStage != Stage.Closed;
    bool ShowChecklist => _rec is not null && (int)_rec.CurrentStage >= (int)Stage.Access;
    bool CanEditChecklist => _rec is not null && Session.Role == PempRoles.Tester && (int)_rec.CurrentStage >= (int)Stage.Access && _rec.CurrentStage != Stage.Closed;
    bool AccessShowEmpty => _rec is not null && (int)_rec.CurrentStage >= (int)Stage.Access;
    bool CredShowEmpty => _rec is not null && (_rec.CurrentStage == Stage.Access || _rec.CurrentStage == Stage.Execution);
    bool FindingsShowEmpty => _rec is not null && (int)_rec.CurrentStage >= (int)Stage.Execution;

    static string TesterName(Guid id) => Array.Find(DemoSeeder.Testers, t => t.Id == id)?.Name ?? "A. Khan";

    // QA peer review records the REAL acting user as the reviewer (no substitution). Map their
    // display name to a tester id so the domain's no-self-review guard (FR-REP-02) compares the
    // actual reviewer against the author; if the author is the only tester present, it blocks.
    Guid ActingTesterId() => Array.Find(DemoSeeder.Testers, t => t.Name == Session.Actor)?.Id ?? Guid.Empty;

    List<EngagementTabs.TabItem> BuildTabs() => new()
    {
        new("overview", "Overview", "▦"),
        new("findings", "Findings", "🐞", _findings.Count > 0 ? _findings.Count : null),
        new("access", "Access & Creds", "🔑", _access.Count > 0 ? _access.Count : null),
        new("evidence", "Evidence", "📎"),
        new("checklist", "Checklist", "✓"),
        new("comms", "Comms", "💬", _comms.Count > 0 ? _comms.Count : null),
        new("audit", "Audit", "🔗"),
    };

    async Task OnTabChanged(string id)
    {
        _activeTab = id;
        if (id == "audit") await EnsureAuditAsync();   // lazy-load the audit rows on first open
    }

    // Load on parameter set (guarded on Id change) so EngagementView→EngagementView navigation
    // (e.g. opening a spawned retest child) refreshes instead of showing stale data.
    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureInitializedAsync(); // resolve role/scope before any scoped fetch (SSR-safe)
        if (Id == _loadedId) return;
        _loadedId = Id;
        _loaded = false;
        _activeTab = "overview";
        await Load();
    }

    async Task Load()
    {
        // anti-BOLA + fail-closed scope: a scoped role with no concrete scope reaches nothing (SEC-AZN/SEC-INS-01).
        _rec = await Store.GetScopedAsync(Id, Session.AppScope, Session.TesterScope, Session.Role);
        InvalidateAudit();
        if (_rec is not null)
        {
            // Tamper-evidence is surfaced automatically on READ (SEC-AUD-01) — verify the chain WITHOUT
            // fetching/rendering the per-engagement audit rows (those load lazily behind the Audit tab).
            _chainOk = Store.VerifyChain();
            _findings = await Store.FindingsForAsync(Id);
            _access = await Store.AccessReqsForAsync(Id);
            _comms = await Comms.MessagesForAsync(Id, Session.Caller);
            _checklist = await Store.ChecklistDoneAsync(Id);
            // Least exposure (SEC-CRD): only fetch test credentials for the assigned tester who may view
            // them — keyed on the stable AssignedTesterId, not the display name.
            _credentials = (Session.Role == PempRoles.Tester && _rec.AssignedTesterId is Guid t && t == Session.TesterScope)
                ? await Store.CredentialsForAsync(Id)
                : new();
            if (_rec.CurrentStage == Stage.Assignment)
                _capacity = await Store.ActiveAssignmentCountsAsync(); // capacity board for the picker
            if (_activeTab == "audit") await EnsureAuditAsync();
        }
        else
        {
            _findings = new(); _access = new(); _checklist = new();
            _credentials = new(); _capacity = new(); _comms = new(); _chainOk = null;
        }
        _loaded = true;
    }

    void InvalidateAudit() { _auditLoaded = false; _audit = new(); }

    // Lazy audit fetch: also re-verifies tamper-evidence for this engagement (SEC-AUD-01).
    async Task EnsureAuditAsync()
    {
        if (_auditLoaded || _rec is null) return;
        var (rows, intact) = await Store.AuditForVerifiedAsync(Id);
        _audit = rows; _chainOk = intact; _auditLoaded = true;
    }

    async Task OnAct(ActionKind k)
    {
        _error = _ok = null;
        if (Workflow.NeedsReauth(k))
        {
            _reauthFor = k;        // open the ReauthDialog ceremony; OnReauthConfirmed runs once verified
        }
        else
        {
            await Run(k, false);   // await so the UI re-renders (async DB providers)
        }
    }

    async Task OnReauthConfirmed()
    {
        var action = _reauthFor;
        _reauthFor = ActionKind.None;
        await Run(action, true);
    }

    void OnReauthCancelled() => _reauthFor = ActionKind.None;

    // Predict the resulting stage for the clear forward transitions so the spine advances instantly
    // (optimistic UI — DESIGN_PLAN §10 / fleet rank 24). Actions that only flip a within-stage flag
    // (SendIr, ReviewSow, PeerReview ±, re-draft) return null → no optimistic move. The server result
    // stays authoritative: a successful action is reconciled by a targeted refetch; a failed one rolls
    // the spine back. This NEVER weakens a guard — it only hides latency on the happy path.
    static Stage? PredictStage(ActionKind k, Stage from) => k switch
    {
        ActionKind.RouteToDm          when from == Stage.Intake     => Stage.Assignment,
        ActionKind.AssignTester       when from == Stage.Assignment => Stage.Scoping,
        ActionKind.CompleteAssessment when from == Stage.Scoping    => Stage.Sow,
        ActionKind.SignSow            when from == Stage.Sow        => Stage.Access,
        ActionKind.VerifyAccess       when from == Stage.Access     => Stage.Execution,
        ActionKind.EndTest            when from == Stage.Execution  => Stage.Findings,
        ActionKind.GenerateDraft      when from == Stage.Findings   => Stage.Report,
        ActionKind.ReleaseFinal       when from == Stage.Report     => Stage.Closed,
        ActionKind.CompleteRetest     when from == Stage.Retest     => Stage.Closed,
        _ => null,
    };

    async Task Run(ActionKind k, bool reauth)
    {
        _reauthFor = ActionKind.None;
        _error = _ok = null;
        if (_rec is null) return;

        var prevStage = _rec.CurrentStage;
        var predicted = PredictStage(k, prevStage);

        _busy = true;
        if (predicted is Stage ps) _rec.CurrentStage = ps;   // optimistic spine advance
        StateHasChanged();                                   // paint the new state before the round-trip

        var actor = Session.Actor;
        var caller = Session.Caller;
        var result = k switch
        {
            ActionKind.RouteToDm        => await Store.ExecuteAsync(Id, caller, EngagementAction.RouteToDeliveryManager, e => e.RouteToDeliveryManager(actor)),
            ActionKind.AssignTester     => await Store.AssignTesterAsync(Id, _assignTesterId, TesterName(_assignTesterId), caller),
            ActionKind.CompleteAssessment => await Store.CompleteAssessmentAsync(Id, caller),
            ActionKind.ReviewSow        => await Store.ExecuteAsync(Id, caller, EngagementAction.ReviewSow, e => e.ReviewSowAsDeliveryManager(actor)),
            ActionKind.SignSow          => await Store.ExecuteAsync(Id, caller, EngagementAction.SignSow, e => e.SignSow(actor, reauth)),
            ActionKind.VerifyAccess     => await Store.VerifyAccessAsync(Id, caller, reauth),
            ActionKind.SendIr           => await Store.ExecuteAsync(Id, caller, EngagementAction.SendIrNotice, e => e.SendIrNotice(actor)),
            ActionKind.EndTest          => await Store.ExecuteAsync(Id, caller, EngagementAction.EndTest, e => e.EndTest(actor)),
            ActionKind.GenerateDraft    => await Store.ExecuteAsync(Id, caller, EngagementAction.GenerateDraft, e => e.GenerateDraft(actor)),
            ActionKind.PeerReview       => await Store.ExecuteAsync(Id, caller, EngagementAction.PeerReview, e => e.PeerReview(ActingTesterId(), true, actor)),
            ActionKind.PeerReviewReject => await Store.ExecuteAsync(Id, caller, EngagementAction.PeerReview, e => e.PeerReview(ActingTesterId(), false, actor)),
            ActionKind.ReleaseFinal     => await Store.ExecuteAsync(Id, caller, EngagementAction.ReleaseFinal, e => e.ReleaseFinal(actor, reauth)),
            ActionKind.CompleteRetest   => await Store.CompleteRetestAsync(Id, caller),
            _ => Result.Fail("Unsupported action."),
        };

        if (result.Failed)
        {
            // Clean rollback: a blocked enforced transition changed nothing server-side, so restore the
            // optimistic spine and surface the error in the existing live-region banner (no flicker).
            _rec.CurrentStage = prevStage;
            _error = result.Error;
            _busy = false;
            return;
        }

        _ok = "Done — state advanced and the audit chain was appended atomically.";
        await RefreshAfterTransitionAsync();   // reconcile only what changed, not the whole page
        _busy = false;
    }

    // Authoritative reconcile after a successful transition: re-fetch ONLY the engagement record (the
    // optimistic guess is replaced by truth), re-verify the tamper indicator, and invalidate the lazy
    // audit rows. Findings / access / checklist / credentials are untouched (they didn't change).
    async Task RefreshAfterTransitionAsync()
    {
        _rec = await Store.GetScopedAsync(Id, Session.AppScope, Session.TesterScope, Session.Role);
        _chainOk = Store.VerifyChain();
        InvalidateAudit();
        if (_rec is not null && _rec.CurrentStage == Stage.Assignment)
            _capacity = await Store.ActiveAssignmentCountsAsync();
        if (_activeTab == "audit") await EnsureAuditAsync();
    }

    // Targeted refresh after a finding is added / retest verdict recorded — only the findings collection
    // (and the tamper indicator) changed; the audit grew, so invalidate its lazy rows.
    async Task OnFindingsChanged()
    {
        _findings = await Store.FindingsForAsync(Id);
        _chainOk = Store.VerifyChain();
        InvalidateAudit();
        if (_activeTab == "audit") await EnsureAuditAsync();
    }

    // Targeted refresh after an access requirement is added — only the access collection changed.
    async Task OnAccessChanged()
    {
        _access = await Store.AccessReqsForAsync(Id);
        _chainOk = Store.VerifyChain();
        InvalidateAudit();
        if (_activeTab == "audit") await EnsureAuditAsync();
    }

    // Targeted refresh after a comms message is posted — only the comms collection (and the audit,
    // since a post is audited) changed.
    async Task OnCommsChanged()
    {
        _comms = await Comms.MessagesForAsync(Id, Session.Caller);
        _chainOk = Store.VerifyChain();
        InvalidateAudit();
        if (_activeTab == "audit") await EnsureAuditAsync();
    }

    void Verify() => _chainOk = Store.VerifyChain();

    async Task Retest()
    {
        _error = _ok = null;
        var (result, childId) = await Store.RequestRetestAsync(Id, Session.Caller);
        if (result.Failed || childId is null) { _error = result.Error; return; }
        Nav.NavigateTo($"engagement/{childId}");
    }

    string ModalTitle() => _reauthFor switch
    {
        ActionKind.SignSow => "Sign Statement of Work",
        ActionKind.VerifyAccess => "Verify access & start testing",
        _ => "Release final report",
    };

    string ModalIntro() => _reauthFor switch
    {
        ActionKind.SignSow => "You are agreeing to:",
        ActionKind.VerifyAccess => "You are confirming:",
        _ => "You are releasing:",
    };

    string[] ModalLines() => _reauthFor switch
    {
        ActionKind.SignSow => new[] { $"Scope: {_rec!.AppName} ({_rec.Type})", "Methodology & dates per the SoW draft", "Prerequisites & test accounts" },
        ActionKind.VerifyAccess => new[] { "Access to the in-scope environments is provisioned and working", "Credentials are valid and time-boxed", "Access is verified — testing can then begin (IR notice next)" },
        _ => new[] { "Final report — peer QA passed", "Vulnerability register snapshot", "Stored immutable on release" },
    };

    static string TypeClass(EngagementType t) =>
        t == EngagementType.Project ? "project" : t == EngagementType.Bau ? "bau" : "retest";
}
