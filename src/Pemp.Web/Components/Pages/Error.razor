@page "/Error"
@layout Pemp.Web.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error · PEMP</PageTitle>

<div class="auth-shell">
    <button type="button" class="btn ghost themebtn theme-float"
            title="Toggle light / dark" aria-label="Toggle light or dark theme">◐ Theme</button>
    <div class="auth-card">
        <a class="auth-brand" href="/">
            <span class="logo">P</span>
            <span class="auth-brand-name">PEMP</span>
        </a>
        <div class="auth-head">
            <h1>Something went wrong</h1>
            <p class="muted">An error occurred while processing your request. The team has the details — please try again.</p>
        </div>

        @if (ShowRequestId)
        {
            <div class="auth-key">
                <span class="muted">Request ID</span>
                <code class="mono">@RequestId</code>
            </div>
        }

        <a class="btn primary auth-submit" href="/">Back to home</a>
    </div>
    <p class="auth-foot muted">Pentest Engagement Management Platform · CloudKonsult for Acme Cyber Assurance</p>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
