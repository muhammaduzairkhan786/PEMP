@page "/dashboard"
@attribute [Authorize]
@inject EngagementStore Store
@inject DemoSession Session
<PageTitle>My Turn · PEMP</PageTitle>

<div class="wrap">
    <div class="eyebrow">@Session.Role · @Session.Actor</div>
    <h1 class="title">My Turn</h1>
    <p class="sub">What needs you now — and what's moving without you.</p>

    @if (_items is null)
    {
        <div aria-busy="true"><Skeleton Rows="5" /></div>
    }
    else
    {
        var mine = _items.Where(i => i.Owner == Session.Role).ToList();
        var others = _items.Where(i => i.Owner != Session.Role).ToList();

        <div class="tiles">
            <div class="tile"><div class="k">Your turn</div><div class="v">@mine.Count</div></div>
            <div class="tile"><div class="k">Waiting on others</div><div class="v">@others.Count</div></div>
            <div class="tile"><div class="k">In flight</div><div class="v">@_items.Count</div></div>
        </div>

        <h2 class="sectionlabel">▸ Your turn <Srs>FR-NOT-01</Srs></h2>
        @if (mine.Count == 0)
        {
            <div class="card muted">You're all clear. <b>@others.Count</b> engagements moving without you.</div>
        }
        <div class="pile">
            @foreach (var i in mine)
            {
                <div class="row">
                    <div class="grow"><span class="verb">@i.Action</span> · @i.Rec.AppName<br><span class="ref">@i.Rec.Reference</span></div>
                    <a class="btn primary" href="@($"engagement/{i.Rec.Id}")" aria-label="Open @i.Rec.AppName">Open ▶</a>
                </div>
            }
        </div>

        <h2 class="sectionlabel">Waiting on others <Srs>FR-NOT-03</Srs></h2>
        @if (others.Count == 0)
        {
            <div class="card muted">Nothing in flight elsewhere right now.</div>
        }
        <div class="pile">
            @foreach (var i in others)
            {
                <div class="row">
                    <div class="grow"><span class="verb">@i.Action</span> · @i.Rec.AppName<br><span class="ref">@i.Rec.Reference · owner: @i.Owner</span></div>
                    <a class="btn ghost" href="@($"engagement/{i.Rec.Id}")" aria-label="Open @i.Rec.AppName">View</a>
                </div>
            }
        </div>
    }
</div>

@code {
    record Item(EngagementRecord Rec, string Action, string Owner);
    List<Item>? _items;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureInitializedAsync(); // resolve role/scope before any query (SSR-safe)
        // Pass the role so the fail-closed scope is enforced AND a Tester's peer-QA review queue
        // (Report-stage engagements authored by another tester) is included (FR-REP-02).
        var recs = await Store.ListScopedAsync(Session.AppScope, Session.TesterScope, Session.Role);
        _items = recs
            .Select(MakeItem)
            .Where(i => i.Owner != "")
            .ToList();
    }

    // Project the next move per engagement, with a Tester-specific peer-review framing so the
    // independent reviewer can find the QA queue and the author isn't shown an action they can't do.
    Item MakeItem(EngagementRecord r)
    {
        var n = Workflow.Next(r);
        if (Session.Role == PempRoles.Tester && r.CurrentStage == Stage.Report && !r.PeerReviewPassed)
        {
            var isAuthor = r.AssignedTesterName == Session.Actor;
            if (r.DraftGenerated)
                return isAuthor
                    ? new Item(r, "Awaiting independent peer review", "Peer reviewer")  // author waits
                    : new Item(r, "Awaiting your peer review", PempRoles.Tester);        // reviewer acts (FR-REP-02)
            // No draft yet (returned for rework): only the author re-drafts; others just wait.
            return isAuthor
                ? new Item(r, "Re-draft report (address QA comments)", PempRoles.Tester)
                : new Item(r, "Awaiting re-draft by author", "Peer reviewer");
        }
        return new Item(r, n.Label, n.OwnerRole);
    }
}
