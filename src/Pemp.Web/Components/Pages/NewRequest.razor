@page "/new-request"
@attribute [Authorize(Roles = "Acme CA Officer")]
@inject EngagementStore Store
@inject DemoSession Session
@inject NavigationManager Nav
<PageTitle>New request · PEMP</PageTitle>

<div class="wrap">
    <div class="eyebrow">Acme CA Officer</div>
    <h1 class="title">New request</h1>
    <p class="sub">A short request, not a long form. It enters Intake; the Delivery Manager picks it up next.</p>

    @if (Session.Role != "Acme CA Officer")
    {
        <div class="banner err">⛔ Raising requests is the Acme CA Officer's action.</div>
    }
    else
    {
        <div class="card">
            <div class="q"><label class="qlabel" for="req-type"><b>Type</b></label>
                <select id="req-type" class="inp" @bind="_type">
                    <option value="@EngagementType.Bau">BAU (routine / recurring)</option>
                    <option value="@EngagementType.Project">Project (release-tied, DM review)</option>
                </select>
            </div>
            <div class="q"><label class="qlabel" for="req-app"><b>Application</b></label>
                <input id="req-app" class="inp" @bind="_app" @bind:event="oninput" @ref="_appRef" @onkeydown="OnAppKey"
                       placeholder="e.g. Claims Portal" aria-invalid="@(_err is not null ? "true" : null)"
                       aria-describedby="@(_err is not null ? "req-err" : null)" />
            </div>
            <div class="q" style="border:none"><label class="qlabel" for="req-crit"><b>Criticality</b></label>
                <select id="req-crit" class="inp" @bind="_crit"><option>High</option><option>Medium</option><option>Low</option></select>
            </div>
        </div>

        <div class="card nextaction">
            <div style="font-size:26px">＋</div>
            <div class="meta"><b>Raise request</b><span class="muted">FR-REQ-01/04 · reference minted, enters Intake</span></div>
            <button class="btn primary" @onclick="Raise" disabled="@string.IsNullOrWhiteSpace(_app)">Raise request ▶</button>
        </div>

        @if (_err is not null)
        {
            <div class="banner err" id="req-err" role="alert">⛔ @_err</div>
        }
    }
</div>

@code {
    EngagementType _type = EngagementType.Bau;
    string _app = "";
    string _crit = "Medium";
    string? _err;
    bool _focusError;
    ElementReference _appRef;

    protected override Task OnInitializedAsync() => Session.EnsureInitializedAsync();

    // Enter in the single Application field raises the request (keyboard parity with the button).
    async Task OnAppKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Raise();
    }

    async Task Raise()
    {
        if (string.IsNullOrWhiteSpace(_app)) { _err = "Enter an application name."; _focusError = true; return; }
        var id = await Store.RaiseAsync(_type, _app.Trim(), _crit, Session.Actor);
        Nav.NavigateTo($"engagement/{id}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusError)
        {
            _focusError = false;
            try { await _appRef.FocusAsync(); } catch { /* not rendered */ }
        }
    }
}
