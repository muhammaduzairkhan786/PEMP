@* Reusable loading skeleton — calm placeholder while data loads (never a blank screen). *@
@for (var i = 0; i < Rows; i++)
{
    <div class="skel skel-row" style="@($"width:{Widths[i % Widths.Length]}%")"></div>
}

@code {
    [Parameter] public int Rows { get; set; } = 4;
    static readonly int[] Widths = { 100, 92, 96, 88, 100, 90 };
}
