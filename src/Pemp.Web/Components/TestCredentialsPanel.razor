@* Masked test-account credentials (SEC-CRD). Secrets render as •••••• until the assigned
   tester clicks Reveal, which passes through the re-auth gate (SEC-IAM-04). Reveal is per-
   credential and time-bound to the view — re-masked on navigation/reload. Secrets are never logged. *@
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject IConfiguration Configuration
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject ILogger<TestCredentialsPanel> Logger
@implements IAsyncDisposable

@if (CanView && Credentials.Count == 0 && ShowEmpty)
{
    <h2 class="sectionlabel">Test credentials <Srs>SEC-CRD</Srs></h2>
    <div class="card muted">No test credentials provisioned yet.</div>
}
else if (CanView && Credentials.Count > 0)
{
    <h2 class="sectionlabel">Test credentials <Srs>SEC-CRD · SEC-IAM-04</Srs></h2>
    <div class="card tablecard">
        <table class="t">
            <thead><tr><th>Account</th><th>Username</th><th>Secret</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Credentials)
                {
                    var shown = _revealed.Contains(c.Id);
                    <tr>
                        <td>@c.Label</td>
                        <td class="mono">@c.Username</td>
                        <td class="mono">@(shown ? c.Secret : "••••••••••")</td>
                        <td style="text-align:right">
                            @if (shown)
                            {
                                <button class="btn ghost" @onclick="() => Hide(c.Id)">Hide</button>
                            }
                            else
                            {
                                <button class="btn" @onclick="() => Ask(c.Id)" title="Re-authentication required (SEC-IAM-04)">🔐 Reveal</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="muted" style="font-size:var(--text-xs);margin-top:8px">
        Masked by default; reveal is re-auth-gated and resets on reload. In production these are held in
        Azure Key Vault / envelope-encrypted (AES-256-GCM), time-boxed and revoked on close<Srs Sep>SEC-CRD-01/02/03</Srs>
    </p>

    @if (_reauthFor is not null)
    {
        <div class="scrim" @onclick="Cancel" @onkeydown="OnModalKey">
            <div class="modal" @ref="_modalRef" tabindex="-1" role="dialog" aria-modal="true"
                 aria-labelledby="cred-gate-title" @onclick:stopPropagation="true">
                <h3 id="cred-gate-title">Reveal test credential</h3>
                <p class="muted" style="margin-bottom:12px">You are about to reveal a secret. This is a privileged action:</p>
                <ul class="attest">
                    <li>Secret is shown only to you, only for this view</li>
                    <li>It is never logged and re-masks on reload</li>
                    <li>Handle per the engagement's data-handling rules</li>
                </ul>
                @if (EntraConfigured)
                {
                    <div class="reauthnote">🔐 Re-authenticate via Entra MFA before it reveals<Srs Sep>SEC-IAM-04</Srs></div>
                }
                else
                {
                    <div class="reauthnote">🔐 Enter your current authenticator (TOTP) code to reveal this secret<Srs Sep>SEC-IAM-04</Srs></div>
                    <input class="inp mono" style="max-width:200px;margin-top:8px" @bind="_totp" @bind:event="oninput"
                           @onkeydown="OnTotpKey" inputmode="numeric" autocomplete="one-time-code" placeholder="123 456" aria-label="Authenticator code" />
                }
                @if (_modalError is not null)
                {
                    <div class="banner err" style="margin-top:8px" role="alert">⛔ @_modalError</div>
                }
                <div class="actions">
                    <button class="btn ghost" @onclick="Cancel">Cancel</button>
                    <button class="btn primary" @onclick="Confirm">@(EntraConfigured ? "Confirm via Entra MFA ▶" : "Verify & reveal ▶")</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid EngagementId { get; set; }
    [Parameter] public List<TestCredentialRecord> Credentials { get; set; } = new();
    [Parameter] public bool CanView { get; set; }
    /// <summary>Show the "none provisioned" empty state when there are no credentials (Access/Execution stages).</summary>
    [Parameter] public bool ShowEmpty { get; set; }

    bool EntraConfigured => !string.IsNullOrWhiteSpace(Configuration["AzureAd:ClientId"]);

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    readonly HashSet<Guid> _revealed = new();
    Guid? _reauthFor;
    ElementReference _modalRef;
    bool _focusModal;
    IJSObjectReference? _focusTrap;
    Guid _loadedId;

    // Fresh-TOTP entry for the local re-auth gate, and any inline error from a bad/blank code.
    string _totp = "";
    string? _modalError;

    // Re-mask everything when the engagement changes (time-bound to the view).
    protected override void OnParametersSet()
    {
        if (EngagementId == _loadedId) return;
        _loadedId = EngagementId;
        _revealed.Clear();
        _reauthFor = null;
        _totp = ""; _modalError = null;
    }

    void Ask(Guid id) { _reauthFor = id; _focusModal = true; _totp = ""; _modalError = null; }

    async Task Cancel()
    {
        await ReleaseFocusTrapAsync();
        _reauthFor = null; _totp = ""; _modalError = null;
    }

    // Reveal only AFTER the re-auth ceremony. Local path: a fresh authenticator TOTP code is
    // verified server-side first; a wrong/blank code blocks the reveal and shows an inline error.
    async Task Confirm()
    {
        if (_reauthFor is not Guid id) return;
        if (EntraConfigured) { _revealed.Add(id); await Cancel(); return; }

        _modalError = null;
        if (await VerifyTotpAsync(_totp))
        {
            _revealed.Add(id);
            await Cancel();
        }
        else
        {
            // Re-auth failure for a credential reveal (SEC-IAM-04 / SEC-CRD). The TOTP code and the
            // secret are NEVER logged — only the engagement + that a reveal attempt failed.
            Logger.LogWarning("Re-auth (TOTP) failed for credential reveal on {EngagementId}", EngagementId);
            _modalError = "That authenticator code wasn't valid. Re-enter the current 6-digit code from your app.";
        }
    }

    // Verify a fresh TOTP against the signed-in user's authenticator key (local Identity path only).
    // The code and the secret are never logged. Returns false on any missing dependency (stays blocked).
    async Task<bool> VerifyTotpAsync(string code)
    {
        if (string.IsNullOrWhiteSpace(code) || AuthState is null) return false;
        var userManager = Services.GetService<UserManager<ApplicationUser>>();
        if (userManager is null) return false;
        var principal = (await AuthState).User;
        var user = await userManager.GetUserAsync(principal);
        if (user is null) return false;
        var normalized = code.Replace(" ", string.Empty).Replace("-", string.Empty);
        return await userManager.VerifyTwoFactorTokenAsync(
            user, userManager.Options.Tokens.AuthenticatorTokenProvider, normalized);
    }

    void Hide(Guid id) => _revealed.Remove(id);

    async Task OnModalKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Cancel();
    }

    // Enter on the TOTP field confirms the reveal (keyboard parity with the primary button);
    // Esc-to-close is handled by OnModalKey on the scrim. Entra path has no TOTP field.
    async Task OnTotpKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Confirm();
    }

    // Trap focus inside the reveal dialog and focus the TOTP input (local path) on open; the trap
    // cycles Tab/Shift+Tab within the dialog and release returns focus to the Reveal button.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModal && _reauthFor is not null)
        {
            _focusModal = false;
            _focusTrap ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/focus-trap.js");
            var initial = EntraConfigured ? null : "input[autocomplete='one-time-code']";
            await _focusTrap.InvokeVoidAsync("activate", _modalRef, initial);
        }
    }

    async Task ReleaseFocusTrapAsync()
    {
        if (_focusTrap is not null)
        {
            try { await _focusTrap.InvokeVoidAsync("release", _modalRef); } catch { /* circuit gone */ }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_focusTrap is not null)
        {
            try { await _focusTrap.DisposeAsync(); } catch { /* circuit already torn down */ }
        }
    }
}
